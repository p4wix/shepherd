{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{root}}/hooks/prod-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "{{root}}/hooks/prod-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
